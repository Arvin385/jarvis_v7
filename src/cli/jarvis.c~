#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/wait.h>

#define MAX_INPUT 4096

typedef enum {
  MODE_LOCAL,
  MODE_LOQ
} Mode;


int main(int argc, char *argv[]) {
  if (argc < 2) {
    printf("JARVIS\nHi, Arvin. Please let me know what I can help with, today.");
    return 1;
  }


  char prompt[MAX_INPUT] = {0};

  for (int i = 1; i < argc; i++){
    strncat(prompt, argv[i], MAX_INPUT - strlen(prompt) -1);

    if (i < argc -1) {
      strncat(prompt, " ", MAX_INPUT - strlen(prompt) -1);
    }
  }
  
  printf("\nJARVIS recieved: %s\n", prompt);
  

  char *args[] = {
    "python",
    "/home/arvin/jarvis_v7/src/cli.py",
    prompt,
    NULL


  };

  pid_t pid = fork();

  if(pid == 0) {
    // child code

    execvp("python", args);

    perror("execvp failed");

    exit(1);

      } else if (pid > 0) {
    // parent code
    wait(NULL);

  } else {
    perror("fork failed");
    return 1;
  }

  return 0;

}
